@page
@model ClinicManagement.Web.Pages.Admin.ManageClinicModel
@{
    ViewData["Title"] = "Manage Clinic";
    Layout = "_AdminLayout";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-cog"></i> Manage Clinic</h2>
        <hr />
    </div>
</div>

<!-- Search Bar -->
<div class="row mb-3">
    <div class="col-md-6">
        <form method="get">
            <div class="input-group">
                <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by name..." />
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
                <a href="/Admin/ManageClinic" class="btn btn-secondary"><i class="fas fa-times"></i> Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" id="manageTabs">
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "doctors" ? "active" : "")" href="?tab=doctors&searchQuery=@Model.SearchQuery">
            <i class="fas fa-user-md"></i> Doctors (@Model.Doctors.Count())
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "patients" ? "active" : "")" href="?tab=patients&searchQuery=@Model.SearchQuery">
            <i class="fas fa-users"></i> Patients (@Model.Patients.Count())
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "staff" ? "active" : "")" href="?tab=staff&searchQuery=@Model.SearchQuery">
            <i class="fas fa-id-badge"></i> Staff (@Model.Staff.Count())
        </a>
    </li>
</ul>

<!-- Doctors Tab -->
@if (Model.ActiveTab == "doctors")
{
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Phone</th>
                            <th>Charges/Visit</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doctor in Model.Doctors)
                        {
                            <tr>
                                <td>@doctor.DoctorId</td>
                                <td>@doctor.Name</td>
                                <td>@doctor.Department</td>
                                <td>@doctor.Phone</td>
                                <td>$@doctor.ChargesPerVisit</td>
                                <td>
                                    <form method="post" asp-page-handler="DeleteDoctor" style="display:inline;">
                                        <input type="hidden" name="id" value="@doctor.DoctorId" />
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to remove this doctor?')">
                                            <i class="fas fa-trash"></i> Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Patients Tab -->
@if (Model.ActiveTab == "patients")
{
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Phone</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model.Patients)
                        {
                            <tr>
                                <td>@patient.PatientId</td>
                                <td>@patient.Name</td>
                                <td>@patient.Phone</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Staff Tab -->
@if (Model.ActiveTab == "staff")
{
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Designation</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var staff in Model.Staff)
                        {
                            <tr>
                                <td>@staff.StaffId</td>
                                <td>@staff.Name</td>
                                <td>@staff.Designation</td>
                                <td>
                                    <form method="post" asp-page-handler="DeleteStaff" style="display:inline;">
                                        <input type="hidden" name="id" value="@staff.StaffId" />
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to remove this staff member?')">
                                            <i class="fas fa-trash"></i> Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
