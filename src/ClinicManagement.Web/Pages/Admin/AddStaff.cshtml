@page
@model ClinicManagement.Web.Pages.Admin.AddStaffModel
@{
    ViewData["Title"] = "Add Staff";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="fas fa-user-plus"></i> Add Staff Member</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert @(Model.Success ? "alert-success" : "alert-danger") alert-dismissible fade show">
                        @Model.Message
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StaffInput.Name" class="form-label">Full Name *</label>
                            <input asp-for="StaffInput.Name" class="form-control" />
                            <span asp-validation-for="StaffInput.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StaffInput.BirthDate" class="form-label">Birth Date</label>
                            <input asp-for="StaffInput.BirthDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StaffInput.Phone" class="form-label">Phone *</label>
                            <input asp-for="StaffInput.Phone" class="form-control" />
                            <span asp-validation-for="StaffInput.Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Gender *</label>
                            <div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="StaffInput.Gender" value="M" id="genderM" />
                                    <label class="form-check-label" for="genderM">Male</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="StaffInput.Gender" value="F" id="genderF" />
                                    <label class="form-check-label" for="genderF">Female</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StaffInput.Address" class="form-label">Address *</label>
                            <input asp-for="StaffInput.Address" class="form-control" />
                            <span asp-validation-for="StaffInput.Address" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StaffInput.Salary" class="form-label">Salary</label>
                            <input asp-for="StaffInput.Salary" type="number" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StaffInput.Qualification" class="form-label">Qualification</label>
                            <input asp-for="StaffInput.Qualification" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StaffInput.Designation" class="form-label">Designation *</label>
                            <input asp-for="StaffInput.Designation" class="form-control" />
                            <span asp-validation-for="StaffInput.Designation" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Add Staff
                        </button>
                        <a href="/Admin/AdminHome" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
