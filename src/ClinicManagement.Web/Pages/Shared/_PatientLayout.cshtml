<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Patient Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-primary" style="background-color: #2c7be5;">
        <div class="container-fluid">
            <a class="navbar-brand text-white" href="/Patient/PatientHome">
                <i class="fas fa-heartbeat"></i> Patient Portal
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Patient/PatientHome"><i class="fas fa-home"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Patient/ViewDoctors"><i class="fas fa-user-md"></i> View Doctors</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Patient/CurrentAppointment"><i class="fas fa-calendar-check"></i> Current Appointment</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Patient/TreatmentHistory"><i class="fas fa-history"></i> Treatment History</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Patient/BillsHistory"><i class="fas fa-file-invoice-dollar"></i> Bills</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Patient/PatientNotifications"><i class="fas fa-bell"></i> Notifications</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Patient/PatientFeedback"><i class="fas fa-star"></i> Feedback</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/SignUp"><i class="fas fa-sign-out-alt"></i> Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid mt-3">
        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
