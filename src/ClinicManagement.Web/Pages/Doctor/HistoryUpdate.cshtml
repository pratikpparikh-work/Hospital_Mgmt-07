@page
@model ClinicManagement.Web.Pages.Doctor.HistoryUpdateModel
@{
    ViewData["Title"] = "Update Patient History";
    Layout = "_DoctorLayout";
}

<h2><i class="fas fa-edit"></i> Update Patient History</h2>
<hr />

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.Success ? "alert-success" : "alert-danger") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow col-md-8">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Patient: @Model.PatientName</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
            <div class="mb-3">
                <label class="form-label">Disease / Diagnosis</label>
                <input type="text" name="disease" value="@Model.Disease" class="form-control" maxlength="100" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Progress</label>
                <input type="text" name="progress" value="@Model.Progress" class="form-control" maxlength="100" />
            </div>
            <div class="mb-3">
                <label class="form-label">Prescription</label>
                <input type="text" name="prescription" value="@Model.Prescription" class="form-control" maxlength="100" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Update
                </button>
                <a href="/Doctor/PatientHistory" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back
                </a>
            </div>
        </form>
    </div>
</div>
