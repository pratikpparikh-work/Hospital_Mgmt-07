@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Patient History";
    Layout = "_DoctorLayout";
}

<h2><i class="fas fa-history"></i> Previous Patient History</h2>
<hr />

@if (!Model.History.Any())
{
    <div class="alert alert-info"><i class="fas fa-info-circle"></i> No patient history found.</div>
}
else
{
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Patient</th>
                            <th>Date</th>
                            <th>Disease</th>
                            <th>Progress</th>
                            <th>Prescription</th>
                            <th>Bill Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.History)
                        {
                            <tr>
                                <td>@h.AppointId</td>
                                <td>@h.PatientName</td>
                                <td>@h.Date?.ToString("MM/dd/yyyy")</td>
                                <td>@h.Disease</td>
                                <td>@h.Progress</td>
                                <td>@h.Prescription</td>
                                <td>
                                    <span class="badge @(h.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                        @h.BillStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
