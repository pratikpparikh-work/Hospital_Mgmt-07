@page
@model ClinicManagement.Web.Pages.Doctor.DoctorHomeModel
@{
    ViewData["Title"] = "Doctor Home";
    Layout = "_DoctorLayout";
}

<div class="row">
    <div class="col-12">
        <h2><i class="fas fa-stethoscope"></i> Welcome, Dr. @Model.DoctorInfo?.Name!</h2>
        <hr />
    </div>
</div>

@if (Model.DoctorInfo != null)
{
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-id-card"></i> My Profile</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr><th>Name:</th><td>Dr. @Model.DoctorInfo.Name</td></tr>
                        <tr><th>Department:</th><td>@Model.DoctorInfo.Department</td></tr>
                        <tr><th>Phone:</th><td>@Model.DoctorInfo.Phone</td></tr>
                        <tr><th>Gender:</th><td>@(Model.DoctorInfo.Gender == "M" ? "Male" : "Female")</td></tr>
                        <tr><th>Age:</th><td>@Model.DoctorInfo.Age years</td></tr>
                        <tr><th>Qualification:</th><td>@Model.DoctorInfo.Qualification</td></tr>
                        <tr><th>Specialization:</th><td>@Model.DoctorInfo.Specialization</td></tr>
                        <tr><th>Work Experience:</th><td>@Model.DoctorInfo.WorkExperience years</td></tr>
                        <tr><th>Charges/Visit:</th><td>$@Model.DoctorInfo.ChargesPerVisit</td></tr>
                        <tr><th>Repute Index:</th><td>@Model.DoctorInfo.ReputeIndex?.ToString("F1")</td></tr>
                        <tr><th>Patients Treated:</th><td>@Model.DoctorInfo.PatientsTreated</td></tr>
                        <tr><th>Monthly Salary:</th><td>$@Model.DoctorInfo.MonthlySalary?.ToString("N2")</td></tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-link"></i> Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/Doctor/PendingAppointment" class="btn btn-outline-warning">
                            <i class="fas fa-clock"></i> Pending Appointments
                        </a>
                        <a href="/Doctor/PatientHistory" class="btn btn-outline-success">
                            <i class="fas fa-calendar-day"></i> Today's Patients
                        </a>
                        <a href="/Doctor/Bill" class="btn btn-outline-primary">
                            <i class="fas fa-file-invoice-dollar"></i> Billing
                        </a>
                        <a href="/Doctor/PreviousHistory" class="btn btn-outline-secondary">
                            <i class="fas fa-history"></i> Patient History
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
