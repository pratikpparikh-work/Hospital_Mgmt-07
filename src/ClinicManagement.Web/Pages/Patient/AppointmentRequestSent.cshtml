@page
@model ClinicManagement.Web.Pages.Patient.AppointmentRequestSentModel
@{
    ViewData["Title"] = "Appointment Request";
    Layout = "_PatientLayout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow text-center">
            <div class="card-body py-5">
                @if (Model.Success)
                {
                    <i class="fas fa-check-circle text-success fa-5x mb-3"></i>
                    <h3 class="text-success">Appointment Request Sent!</h3>
                    <p class="text-muted">@Model.Message</p>
                    <p>Your appointment request has been sent to the doctor. You will be notified once it is approved.</p>
                }
                else
                {
                    <i class="fas fa-times-circle text-danger fa-5x mb-3"></i>
                    <h3 class="text-danger">Request Failed</h3>
                    <p class="text-muted">@Model.Message</p>
                }
                <a href="/Patient/PatientHome" class="btn btn-primary mt-3">
                    <i class="fas fa-home"></i> Go to Home
                </a>
            </div>
        </div>
    </div>
</div>
