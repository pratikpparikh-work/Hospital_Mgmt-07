@page
@model ClinicManagement.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
    Layout = "_PatientLayout";
}

<h2><i class="fas fa-star"></i> Patient Feedback</h2>
<hr />

@if (Model.FeedbackSubmitted)
{
    <div class="alert alert-success"><i class="fas fa-check-circle"></i> Thank you for your feedback!</div>
}
else if (!Model.HasPendingFeedback)
{
    <div class="alert alert-info"><i class="fas fa-info-circle"></i> No pending feedback at this time.</div>
}
else
{
    <div class="card shadow col-md-6">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="fas fa-star"></i> Pending Feedback</h5>
        </div>
        <div class="card-body">
            <p><strong>Doctor:</strong> @Model.DoctorName</p>
            <p><strong>Appointment Time:</strong> @Model.Timings</p>
            <p>Please provide your feedback for this appointment.</p>
            <form method="post">
                <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-thumbs-up"></i> Submit Feedback
                </button>
            </form>
        </div>
    </div>
}
