@page
@model ClinicManagement.Web.Pages.Patient.PatientHomeModel
@{
    ViewData["Title"] = "Patient Home";
    Layout = "_PatientLayout";
}

<div class="row">
    <div class="col-12">
        <h2><i class="fas fa-home"></i> Welcome, @Model.PatientInfo?.Name!</h2>
        <hr />
    </div>
</div>

<div class="row">
    <!-- Patient Info Card -->
    <div class="col-md-4">
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-user"></i> My Profile</h5>
            </div>
            <div class="card-body">
                @if (Model.PatientInfo != null)
                {
                    <table class="table table-borderless">
                        <tr><th>Name:</th><td>@Model.PatientInfo.Name</td></tr>
                        <tr><th>Phone:</th><td>@Model.PatientInfo.Phone</td></tr>
                        <tr><th>Address:</th><td>@Model.PatientInfo.Address</td></tr>
                        <tr><th>Birth Date:</th><td>@Model.PatientInfo.BirthDate</td></tr>
                        <tr><th>Age:</th><td>@Model.PatientInfo.Age years</td></tr>
                        <tr><th>Gender:</th><td>@(Model.PatientInfo.Gender == "M" ? "Male" : "Female")</td></tr>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Current Appointment Card -->
    <div class="col-md-4">
        <div class="card shadow mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-calendar-check"></i> Today's Appointment</h5>
            </div>
            <div class="card-body">
                @if (Model.CurrentAppointment != null)
                {
                    <p><strong>Doctor:</strong> @Model.CurrentAppointment.DoctorName</p>
                    <p><strong>Time:</strong> @Model.CurrentAppointment.Timings</p>
                }
                else
                {
                    <p class="text-muted">No appointment scheduled for today.</p>
                    <a href="/Patient/ViewDoctors" class="btn btn-success btn-sm">
                        <i class="fas fa-calendar-plus"></i> Book Appointment
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Quick Links Card -->
    <div class="col-md-4">
        <div class="card shadow mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-link"></i> Quick Links</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Patient/ViewDoctors" class="btn btn-outline-primary">
                        <i class="fas fa-user-md"></i> View Doctors
                    </a>
                    <a href="/Patient/TreatmentHistory" class="btn btn-outline-success">
                        <i class="fas fa-history"></i> Treatment History
                    </a>
                    <a href="/Patient/BillsHistory" class="btn btn-outline-warning">
                        <i class="fas fa-file-invoice-dollar"></i> Bills History
                    </a>
                    <a href="/Patient/PatientNotifications" class="btn btn-outline-info">
                        <i class="fas fa-bell"></i> Notifications
                    </a>
                    <a href="/Patient/PatientFeedback" class="btn btn-outline-secondary">
                        <i class="fas fa-star"></i> Give Feedback
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
