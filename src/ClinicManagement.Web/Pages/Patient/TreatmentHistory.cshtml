@page
@model ClinicManagement.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
    Layout = "_PatientLayout";
}

<h2><i class="fas fa-history"></i> Treatment History</h2>
<hr />

@if (!Model.Treatments.Any())
{
    <div class="alert alert-info"><i class="fas fa-info-circle"></i> No treatment history found.</div>
}
else
{
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Doctor</th>
                            <th>Date</th>
                            <th>Disease</th>
                            <th>Progress</th>
                            <th>Prescription</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Treatments)
                        {
                            <tr>
                                <td>@t.AppointId</td>
                                <td>@t.DoctorName</td>
                                <td>@t.Date?.ToString("MM/dd/yyyy")</td>
                                <td>@t.Disease</td>
                                <td>@t.Progress</td>
                                <td>@t.Prescription</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
