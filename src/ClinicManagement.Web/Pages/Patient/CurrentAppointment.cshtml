@page
@model ClinicManagement.Web.Pages.Patient.CurrentAppointmentModel
@{
    ViewData["Title"] = "Current Appointment";
    Layout = "_PatientLayout";
}

<h2><i class="fas fa-calendar-check"></i> Current Appointment</h2>
<hr />

@if (Model.CurrentAppointment == null)
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No appointment scheduled for today.
        <a href="/Patient/ViewDoctors" class="btn btn-primary btn-sm ms-2">
            <i class="fas fa-calendar-plus"></i> Book Appointment
        </a>
    </div>
}
else
{
    <div class="card shadow col-md-6">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="fas fa-calendar-check"></i> Today's Appointment</h5>
        </div>
        <div class="card-body">
            <p><strong><i class="fas fa-user-md"></i> Doctor:</strong> @Model.CurrentAppointment.DoctorName</p>
            <p><strong><i class="fas fa-clock"></i> Time:</strong> @Model.CurrentAppointment.Timings</p>
        </div>
    </div>
}
