@page
@model ClinicManagement.Web.Pages.Patient.ViewDoctorsModel
@{
    ViewData["Title"] = "View Doctors";
    Layout = "_PatientLayout";
}

<h2><i class="fas fa-user-md"></i> View Doctors</h2>
<hr />

<div class="row mb-3">
    <div class="col-md-6">
        <form method="get">
            <div class="input-group">
                <select name="deptName" class="form-select">
                    <option value="">-- Select Department --</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.DeptName" selected="@(dept.DeptName == Model.SelectedDepartment)">
                            @dept.DeptName
                        </option>
                    }
                </select>
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Doctors.Any())
{
    <div class="row">
        @foreach (var doctor in Model.Doctors)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-user-md text-primary"></i> @doctor.Name</h5>
                        <p class="card-text">
                            <strong>Department:</strong> @doctor.Department<br />
                            <strong>Phone:</strong> @doctor.Phone<br />
                            <strong>Charges/Visit:</strong> $@doctor.ChargesPerVisit
                        </p>
                    </div>
                    <div class="card-footer">
                        <a href="/Patient/DoctorProfile?doctorId=@doctor.DoctorId" class="btn btn-info btn-sm">
                            <i class="fas fa-eye"></i> View Profile
                        </a>
                        <a href="/Patient/AppointmentTaker?doctorId=@doctor.DoctorId" class="btn btn-success btn-sm">
                            <i class="fas fa-calendar-plus"></i> Book
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(Model.SelectedDepartment))
{
    <div class="alert alert-info">No doctors found for the selected department.</div>
}
